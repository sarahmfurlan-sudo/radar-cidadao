    {
        "id": "eee234633af23cd9",
        "type": "function",
        "z": "69e5326f76928c61",
        "name": "processarTelemetria",
        "func": "const p = msg.payload;\nflow.set(\"ultimoStatus\", {\n    ...p,\n    atualizado_em: new Date().toISOString()\n});\n\nconst nivelAgua = { payload: p.nivel_agua_pct, topic: \"Nível da Água (%)\" };\nconst chuva = { payload: p.chuva_pct, topic: \"Chuva (%)\" };\nconst dist = { payload: p.distancia_cm };\nconst risco = { payload: `${p.nivel_risco} (${p.regiao})` };\n\nreturn [nivelAgua, chuva, dist, risco];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
