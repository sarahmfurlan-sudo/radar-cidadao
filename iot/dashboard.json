    {
        "id": "rc_fn_alerta_01",
        "type": "function",
        "z": "69e5326f76928c61",
        "name": "Registrar Alerta",
        "func": "const alerta = {\n    ...msg.payload,\n    recebido_em: new Date().toISOString()\n};\nflow.set(\"ultimoAlerta\", alerta);\n\nconst historico = flow.get(\"historicoAlertas\") || [];\nhistorico.unshift(alerta);\nif (historico.length > 20) historico.pop();\nflow.set(\"historicoAlertas\", historico);\n\nif (alerta.nivel_risco === \"ALERTA\") {\n    return {\n        payload: `${alerta.regiao}: ${alerta.mensagem}`,\n        topic: \"ALERTA DE ALAGAMENTO\"\n    };\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 460,
        "wires": [
